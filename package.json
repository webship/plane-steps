{
  "name": "@webship-js/plane-steps",
  "version": "2.0.1",
  "description": "Cucumber step definitions for Plane, the open-source project and work management software (Community Edition), a pack for webship-js (Playwright and Cucumber): logging in and out and its refusals, a project and who may open it, the work item list, one work item (its state, its comments, its assignee, who last edited it), a new work item, a Guest's limits, and the cycles with their work items. Test content is made and removed through the site's own API, so a run leaves the site as it found it.",
  "main": "tests/step-definitions/plane-helpers.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "plane",
    "project-management",
    "work-management",
    "work-items",
    "cycles",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/plane-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/plane-steps/issues"
  },
  "homepage": "https://github.com/webship/plane-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.17"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
